      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 5c5f09fb13043154c9c3a6b3e48ea06d, type: 3}
    m_FontSize: 54
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.05
  m_Text: "\u2022 Mira los <b>c\xEDrculos azules</b> del suelo para avanzar por el pasillo.\n\u2022 Mira un <b>modelo</b> hasta llenar el anillo para animarlo.\n\u2022 Usa <b>Contemplar</b> en las placas para admirar una pieza.\n\u2022 Busca los <b>tickets dorados</b> escondidos en el museo.\n\u2022 La <b>X</b> del visor te lleva al men\xFA principal."
