  m_Text: "<color=#5C738F>\u25A0</color> <b>Aviones de combate</b>\n   F-15, Rafale y F-22\n\n<color=#738C6B>\u25A0</color> <b>Dinosaurios</b>\n   T-Rex, Triceratops y m\xE1s\n\n<color=#9E80B8>\u25A0</color> <b>Hongos</b>\n   Amanita, Boletus y un bosque\n\n<color=#A86B5C>\u25A0</color> <b>Carros</b>\n   Deportivo, sed\xE1n, pickup y rally"
